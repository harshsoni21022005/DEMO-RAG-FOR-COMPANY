# ============================================================
# XDR RAG Pipeline — Environment Configuration Template
# Copy this file to .env and fill in your actual values
# ============================================================

# ----------------------------------------------------------
# MongoDB Atlas
# ----------------------------------------------------------
# Full MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb+srv://harsh:harsh@xdr-cluster.mongodb.net/?retryWrites=true&w=majority

# Database name
MONGODB_DB=xdr_db

# Atlas Vector Search index name (must match vector_search_index.json)
VECTOR_INDEX_NAME=xdr_vector_index

# ----------------------------------------------------------
# OpenAI / LM Studio (LLM)
# ----------------------------------------------------------
# Your OpenAI API key (leave blank if using LM Studio)
OPENAI_API_KEY=sk-...

# LLM model name
# For OpenAI: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
# For LM Studio: the model identifier shown in LM Studio
LLM_MODEL=gpt-4o

# Override the LLM base URL if using LM Studio or a custom proxy
# Leave blank to use the default OpenAI API endpoint
# Example for LM Studio: http://localhost:1234/v1
LLM_BASE_URL=

# LLM temperature (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.0

# ----------------------------------------------------------
# HuggingFace (Local Embeddings)
# ----------------------------------------------------------
# We use local, free HuggingFace embeddings running directly on your machine.
# No API key is required.
# Default model: all-MiniLM-L6-v2 (fast, lightweight, 384 dimensions)
EMBED_MODEL=all-MiniLM-L6-v2

# Embedding vector dimension (must match the model output size)
# all-MiniLM-L6-v2: 384
# BAAI/bge-small-en-v1.5: 384
EMBED_DIMENSIONS=384

# ----------------------------------------------------------
# Kafka
# ----------------------------------------------------------
# Kafka broker(s) — comma-separated
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Kafka topic for raw XDR events
KAFKA_TOPIC=xdr.events

# Kafka consumer group ID for any consumers
KAFKA_GROUP_ID=xdr-rag-consumers

# ----------------------------------------------------------
# Kafka Connect
# ----------------------------------------------------------
# REST endpoint for Kafka Connect
KAFKA_CONNECT_URL=http://localhost:8083

# ----------------------------------------------------------
# Elasticsearch
# ----------------------------------------------------------
# Elasticsearch host URL
ELASTICSEARCH_URL=http://localhost:9200

# Optional: Elasticsearch username/password (if security enabled)
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Elasticsearch index name for XDR logs
ELASTICSEARCH_INDEX=xdr_logs

# ----------------------------------------------------------
# FastAPI
# ----------------------------------------------------------
# Port for the FastAPI server
API_PORT=8000

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:8501

# ----------------------------------------------------------
# Streamlit UI
# ----------------------------------------------------------
# URL of the FastAPI backend (used by Streamlit)
API_BASE_URL=http://localhost:8000

# ----------------------------------------------------------
# Worker tuning
# ----------------------------------------------------------
# How often the summarization worker checks for new events (seconds)
SUMMARIZATION_INTERVAL=60

# Batch size for the embedding worker
EMBEDDING_BATCH_SIZE=50

# Sleep between embedding batches (seconds)
EMBEDDING_SLEEP=10

# Maximum retries on embedding API errors
EMBEDDING_MAX_RETRIES=3
